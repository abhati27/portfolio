# PostHog analytics (optional). Copy this file to `.env.local` and fill in.
# The project API key is a PUBLISHABLE client-side key — safe to expose in the
# browser bundle. If these are left unset, analytics is simply disabled.
#
# Get them from https://app.posthog.com → Settings → Project → "Project API Key".
# Host is https://us.i.posthog.com (US cloud) or https://eu.i.posthog.com (EU cloud).

NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
